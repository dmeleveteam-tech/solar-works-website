# ---------------------------------------------------------------------------
# Solar Works Platform — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (mongodb+srv://...). Required.
MONGODB_URI=""
# Database name better-auth and app collections live in.
MONGODB_DB="solarworks"

# better-auth — generate a fresh secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Public base URL of this app (no trailing slash).
BETTER_AUTH_URL="https://solar-works-admin.vercel.app"

# Google OAuth (customer sign-in). Leave blank to disable Google sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared secret the marketing site presents to POST /api/leads (the public
# contact-form ingest). Must match LEADS_INGEST_KEY in the landing app.
# Leave blank to keep the ingest endpoint closed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEADS_INGEST_KEY=""

# Cloudinary — CMS image/video/document uploads (project photos, testimonial
# images/videos, customer documents). Create an account at
# https://cloudinary.com and copy these from the dashboard.
# Leave blank to disable uploads (the CMS upload fields will error on upload).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Same values as CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY, exposed to the
# browser so the upload widget can build signed requests. The API key alone
# cannot authorize an upload without a valid signature (which requires
# CLOUDINARY_API_SECRET, kept server-only) — not a secret.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""

# New-lead email notification (sales alert sent when a lead is captured).
# Uses Resend (https://resend.com) — create an API key and a verified sender.
# All three must be set for notifications to send; leave any blank to disable.
RESEND_API_KEY=""
# Verified sender, e.g. "Solar Works <leads@solarworks.ph>".
LEADS_NOTIFY_FROM=""
# Comma-separated recipient inbox(es), e.g. "sales@solarworks.ph".
LEADS_NOTIFY_TO=""
# Public base URL used to link the dashboard from the email. Defaults to
# BETTER_AUTH_URL when blank.
APP_URL=""
