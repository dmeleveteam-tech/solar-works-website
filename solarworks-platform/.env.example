# ---------------------------------------------------------------------------
# Solar Works Platform — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (mongodb+srv://...). Required.
MONGODB_URI=""
# Database name better-auth and app collections live in.
MONGODB_DB="solarworks"

# better-auth — generate a fresh secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Public base URL of this app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3001"

# Google OAuth (customer sign-in). Leave blank to disable Google sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
