# ---------------------------------------------------------------------------
# Solar Works — environment variables (local dev)
# Copy this file to `.env` and fill in real values. NEVER commit `.env` — only
# this template (placeholders only, no real secrets) belongs in git.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database + auth (REQUIRED — the platform app will not start without these)
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string. Create a FREE M0 cluster (no credit card) at
# https://cloud.mongodb.com, add a DB user, allow 0.0.0.0/0 under Network
# Access, then Connect → Drivers and paste the mongodb+srv://… string here.
# If this machine's DNS refuses SRV records (MongoServerSelectionError), use the
# non-SRV connection string form instead (Atlas "older driver" option) — name
# the three shard hosts directly to remove the SRV lookup altogether.
# On Vercel use the mongodb+srv:// form instead; its DNS is fine and the SRV
# string survives Atlas replacing individual hosts.
MONGODB_URI="mongodb+srv://<db-user>:<db-password>@<cluster-host>/"
MONGODB_DB="solarworks"
# Local-only DNS workaround: some networks refuse Atlas SRV lookups
# (querySrv ECONNREFUSED) — resolve through public DNS instead. Leave UNSET on
# Vercel — its DNS resolves SRV fine.
MONGODB_DNS_SERVERS="1.1.1.1,8.8.8.8"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Public base URL of the platform. Localhost for dev; the real HTTPS URL in prod.
BETTER_AUTH_URL="http://localhost:3001"

# Lead intake (platform ingest)
PLATFORM_INGEST_URL="http://localhost:3001/api/leads"
# Shared secret the marketing site presents to POST /api/leads. Must match the
# landing app's copy. Leave blank to keep the ingest endpoint closed. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEADS_INGEST_KEY=""
PLATFORM_CONTENT_URL="http://localhost:3001/api/content"

# Base URL of the marketing site. When set (with REVALIDATE_SECRET below), the
# CMS pushes a cache purge there right after every publish/edit/delete, so the
# change shows up live immediately instead of waiting out the site's ISR
# window. Leave blank to skip this — the site still catches up on its own.
# Local dev: the marketing site runs on :3000.
LANDING_SITE_URL="http://localhost:3000"
# Shared secret for that push. MUST match REVALIDATE_SECRET in the marketing
# site's .env. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=""

# ---------------------------------------------------------------------------
# New-lead sales alert + project-status emails (Resend). Read by the PLATFORM
# only — the landing app never sends mail. Leave any blank to disable.
# ---------------------------------------------------------------------------
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=""
# Resend's shared test sender — works with no verified domain, but only
# delivers to your own Resend signup address. Verify your own domain in the
# Resend dashboard (Domains → Add Domain) to send to real customers, then
# switch this to e.g. "SolarWorks Team <noreply@solarworks.ph>".
LEADS_NOTIFY_FROM="Solar Works <onboarding@resend.dev>"
# Comma-separated sales inbox. Must be the Resend account email until a domain
# is verified.
LEADS_NOTIFY_TO=""

# Cloudflare Turnstile (leave blank to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Analytics (leave blank to disable)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ---------------------------------------------------------------------------
# Solar Assistant chatbot — LLM provider
#
# The brain lives here (lib/chat/brain.ts), serving both the marketing site's
# widget (via POST /api/chat) and the Messenger bot. It accepts either Groq or
# xAI — both speak the OpenAI chat-completions dialect — and GROQ_API_KEY wins
# when both are set.
# ---------------------------------------------------------------------------
# Free tier, no credit card required: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# xAI (Grok) — needs credits purchased at console.x.ai to actually respond.
# Left as a fallback; Groq above takes precedence when both are set.
XAI_API_KEY=""
XAI_MODEL="grok-4.5"

# Shared secret the marketing site presents to POST /api/chat. IDENTICAL in
# both apps' .env. Blank = the endpoint is closed and the site falls back to
# its human hand-off message.
CHAT_API_KEY=""

# ---------------------------------------------------------------------------
# Cloudinary — CMS media uploads (testimonial/project images & videos)
# Create a free account at https://cloudinary.com, then Dashboard → copy the
# Cloud Name, API Key, and API Secret. Leave any unset and the CMS upload
# widget will fail (Cloudinary rejects the request, surfacing as a 404).
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Same cloud name and key, exposed to the browser — the upload widget runs
# client-side and reads these directly (next-cloudinary's default env var
# names). The API key is not secret; only CLOUDINARY_API_SECRET above is.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""

# ---------------------------------------------------------------------------
# Facebook Messenger bot
#
# All three FB_* below must be set or messengerEnabled stays false and the
# webhook refuses everything (403 on the handshake, no replies).
# ---------------------------------------------------------------------------
# Numeric Page ID from Business Settings. Not read by any Messenger code —
# kept here for parity with the marketing site's "Continue on Messenger" link.
FB_PAGE_ID=""
# Meta for Developers → your app → Settings → Basic → App Secret. Verifies the
# X-Hub-Signature-256 on every delivery — without it the webhook is a
# lead-injection vector, so it rejects unsigned requests outright.
FB_APP_SECRET=""
# Meta for Developers → your app → Messenger API settings → Generate access
# token (pick the correct Page). Starts "EAA", several hundred characters.
FB_PAGE_ACCESS_TOKEN=""
# Our own string; must match what you enter in the webhook setup screen.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FB_WEBHOOK_VERIFY_TOKEN=""
# Same Page ID, exposed to the browser to build the "Continue on Messenger" link.
NEXT_PUBLIC_FB_PAGE_ID=""

# ---------------------------------------------------------------------------
# Chatbot knowledge base (RAG)
# ---------------------------------------------------------------------------
# Cohere embeddings — free trial key (no credit card) at https://cohere.com.
# Blank = retrieval disabled (chatbot falls back to prompt-only).
COHERE_API_KEY=""
# Shared secret between the landing chatbot and the platform /api/kb/search.
# IDENTICAL in both apps' .env.
KB_SEARCH_KEY=""
# Landing → platform KB search endpoint (platform runs on :3001 in dev).
KB_SEARCH_URL="http://localhost:3001/api/kb/search"
# Similarity cutoff (0–1). Tuned via pnpm test:kb; 0.75 cleanly separates
# in-scope (~0.83+) from out-of-scope (~0.69-) on the current chunk set.
KB_MIN_SCORE="0.75"

# ---------------------------------------------------------------------------
# n8n downstream automation (optional)
# ---------------------------------------------------------------------------
# When set, every captured lead is POSTed to this webhook (fire-and-forget).
# Leave blank to disable.
N8N_LEAD_WEBHOOK_URL=""
# Sent as `x-webhook-secret` so the webhook can authenticate us. Optional.
N8N_WEBHOOK_SECRET=""
