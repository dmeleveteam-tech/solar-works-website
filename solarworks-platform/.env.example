# ---------------------------------------------------------------------------
# Solar Works Platform — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (mongodb+srv://...). Required.
MONGODB_URI=""
# Database name better-auth and app collections live in.
MONGODB_DB="solarworks"

# better-auth — generate a fresh secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Public base URL of this app (no trailing slash).
BETTER_AUTH_URL="https://solar-works-admin.vercel.app"

# Google OAuth (customer sign-in). Leave blank to disable Google sign-in.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared secret the marketing site presents to POST /api/leads (the public
# contact-form ingest). Must match LEADS_INGEST_KEY in the landing app.
# Leave blank to keep the ingest endpoint closed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEADS_INGEST_KEY=""

# Cloudinary — CMS image/video/document uploads (project photos, testimonial
# images/videos, customer documents). Create an account at
# https://cloudinary.com and copy these from the dashboard.
# Leave blank to disable uploads (the CMS upload fields will error on upload).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Same values as CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY, exposed to the
# browser so the upload widget can build signed requests. The API key alone
# cannot authorize an upload without a valid signature (which requires
# CLOUDINARY_API_SECRET, kept server-only) — not a secret.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""

# New-lead email notification (sales alert sent when a lead is captured).
# Uses Resend (https://resend.com) — create an API key and a verified sender.
# All three must be set for notifications to send; leave any blank to disable.
RESEND_API_KEY=""
# Verified sender, e.g. "Solar Works <leads@solarworks.ph>".
LEADS_NOTIFY_FROM=""
# Comma-separated recipient inbox(es), e.g. "sales@solarworks.ph".
LEADS_NOTIFY_TO=""
# Public base URL used to link the dashboard from the email. Defaults to
# BETTER_AUTH_URL when blank.
APP_URL=""

# ---------------------------------------------------------------------------
# Chatbot knowledge base (RAG). Powers POST /api/kb/search, which the marketing
# site's chatbot calls to answer FAQ-style questions from approved content.
# Leave COHERE_API_KEY or KB_SEARCH_KEY blank to disable retrieval — the chatbot
# then falls back to its existing prompt-only behaviour.
# ---------------------------------------------------------------------------
# Cohere embeddings key. Free trial key (no credit card) at https://cohere.com.
# Model: embed-multilingual-v3.0 (1024 dims). Used to embed KB chunks + queries.
COHERE_API_KEY=""
# Shared secret the marketing site presents to /api/kb/search. Generate a strong
# random value; MUST match KB_SEARCH_KEY in the landing app.
KB_SEARCH_KEY=""
# Similarity cutoff (0–1) below which retrieval escalates instead of answering.
# Defaults to 0.75; tune with `pnpm test:kb`.
KB_MIN_SCORE=""

# ---------------------------------------------------------------------------
# Solar Assistant chat brain (lib/chat/brain.ts). This app now runs the chatbot
# for BOTH the marketing site's widget (via POST /api/chat) and the Facebook
# Messenger bot, so the LLM provider key lives here and not in the landing app.
# Leave both provider keys blank to disable the assistant — every channel then
# degrades to its human hand-off message rather than erroring.
# ---------------------------------------------------------------------------
# Groq is preferred when both are set: its free tier needs no credit card,
# whereas an xAI key without purchased credits authenticates fine but fails
# every request with permission-denied. Key from https://console.groq.com.
GROQ_API_KEY=""
# Defaults to llama-3.3-70b-versatile when blank.
GROQ_MODEL=""
# xAI (Grok) fallback — same OpenAI chat-completions dialect, tool calls
# included. Key from https://console.x.ai.
XAI_API_KEY=""
# Defaults to grok-3-mini when blank.
XAI_MODEL=""
# Shared secret the marketing site presents to POST /api/chat. MUST match
# CHAT_API_KEY in the landing app. Blank = the endpoint is closed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHAT_API_KEY=""

# ---------------------------------------------------------------------------
# Facebook Messenger bot. Leave any of these blank to disable it entirely.
# Set up at https://developers.facebook.com — a Business-type app with the
# Messenger product and the Page linked.
# ---------------------------------------------------------------------------
# App Secret, used to verify the X-Hub-Signature-256 on every webhook delivery.
# The webhook is publicly reachable, so in practice this is not optional.
FB_APP_SECRET=""
# Page Access Token, used to send replies via the Send API.
FB_PAGE_ACCESS_TOKEN=""
# A string you choose; paste the same value into Meta's webhook subscription
# form so the GET handshake can be answered.
FB_WEBHOOK_VERIFY_TOKEN=""

# ---------------------------------------------------------------------------
# n8n downstream automation (optional). When set, every captured lead is POSTed
# to this webhook so it flows through the n8n canvas (fan out to Sheets/Slack/…).
# Fire-and-forget: an n8n outage never affects lead capture. Leave blank to
# disable. Locally use the tunnel/production webhook URL (see below) so the URL
# is reachable — Vercel cannot reach http://localhost:5678.
# ---------------------------------------------------------------------------
N8N_LEAD_WEBHOOK_URL=""
# Optional shared secret sent as `x-webhook-secret`. Set a matching Header Auth
# credential on the n8n Webhook node to reject unauthenticated posts.
N8N_WEBHOOK_SECRET=""
