# ---------------------------------------------------------------------------
# Solar Works — marketing site environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Where the contact form forwards leads — the platform app's ingest endpoint.
# Local dev: the platform runs on :3001.
PLATFORM_INGEST_URL="http://localhost:3001/api/leads"

# Shared secret for the ingest endpoint. MUST match LEADS_INGEST_KEY in the
# platform app's .env, or every submission is rejected with 401.
LEADS_INGEST_KEY=""

# Base URL of the platform's public content API (the back-office CMS). The site
# reads published testimonials, projects, and FAQs from here with ISR caching.
# When unset, the site falls back to its bundled static content.
# Local dev: the platform runs on :3001.
PLATFORM_CONTENT_URL="http://localhost:3001/api/content"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — contact-form spam protection (NFR-02).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Both keys must be set to enable the check; leave blank to disable it.
# ---------------------------------------------------------------------------
# Public site key (shipped to the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Secret key (server-side verification only — never exposed to the browser).
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Analytics — GA4 + Meta Pixel (loaded only after visitor consent).
# Leave blank to disable each independently.
# ---------------------------------------------------------------------------
# GA4 Measurement ID, e.g. "G-XXXXXXXXXX".
NEXT_PUBLIC_GA_ID=""
# Meta (Facebook) Pixel ID, e.g. "123456789012345".
NEXT_PUBLIC_META_PIXEL_ID=""

# ---------------------------------------------------------------------------
# Facebook Messenger — the floating chat launcher on every page links straight
# to the Solar Works Page on Messenger (m.me deep link). There is no more
# in-site chat widget on this app: the old AI Solar Assistant widget and its
# `/api/chat` proxy (CHAT_API_URL / CHAT_API_KEY) were removed, since visitors
# now go straight to Messenger instead.
#
# The Messenger BOT itself lives in the platform app (app/api/messenger/webhook),
# which owns every Messenger secret. This app holds no token and no verify
# token — just the public Page ID used to build the m.me deep link.
#
# Leave blank to fall back to the Viber contact link instead.
# ---------------------------------------------------------------------------
# Public Page ID (numeric). Use the CLASSIC Page ID from Business Settings, not
# the id in a profile.php?id=… URL, and make sure it names the same Page the
# platform's FB_PAGE_ACCESS_TOKEN is bound to.
NEXT_PUBLIC_FB_PAGE_ID=""
